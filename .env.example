# انسخ هذا الملف إلى .env وعدّل القيم
PORT=3000
# مفتاح مجاني من https://www.football-data.org/client/register  (اتركه فارغاً للوضع التجريبي)
FOOTBALL_DATA_KEY=
# PD = الدوري الإسباني، SA = الدوري الإيطالي
LEAGUES=PD,SA
# كلمة سر لأوامر المدير (/api/admin/...). اختر نصاً طويلاً عشوائياً
ADMIN_KEY=
# 1 = نتائج محاكاة، 0 = نتائج حقيقية. الافتراضي: محاكاة إذا لم يوجد مفتاح
# DEMO=1
# مكان قاعدة البيانات. على الاستضافة اجعله على قرص دائم
# DB_PATH=./data/draft-duel.db

# --- الحسابات ---
# عنوان موقعك العام (يُستخدم في روابط استعادة كلمة السر)
BASE_URL=http://localhost:3000
# دخول Google (اختياري): Client ID من https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
# إرسال الإيميلات (اختياري) من https://resend.com . بدونه تُطبع روابط الاستعادة في سجل الخادم فقط
RESEND_KEY=
MAIL_FROM=Draft Duel <onboarding@resend.dev>
